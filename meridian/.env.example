# Meridian Environment Variables
# Copy this file to .env and fill in your values

# Server
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000
LOG_LEVEL=debug

# Database
DATABASE_URL=postgresql://localhost:5432/meridian

# Gemini Live (required for conversation)
GEMINI_API_KEY=

# Replicate (required for Phase 4)
REPLICATE_API_TOKEN=
