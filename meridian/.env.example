# Meridian Environment Variables
# Copy this file to .env and fill in your values

# Server
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000
LOG_LEVEL=debug

# Database
DATABASE_URL=postgresql://localhost:5432/meridian

# Daily.co (required for Phase 1)
DAILY_API_KEY=

# Claude (required for Phase 3)
CLAUDE_API_KEY=

# Deepgram (required for Phase 3)
DEEPGRAM_API_KEY=

# Inworld TTS (required for Phase 3)
INWORLD_API_KEY=

# Replicate (required for Phase 4)
REPLICATE_API_TOKEN=
