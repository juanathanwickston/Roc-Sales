# Sales Call Simulator — Required Environment Variables
# Copy to .env for local development. Do not commit .env.

# Server
PORT=3001
NODE_ENV=development

# Database — Railway Postgres connection string
DATABASE_URL=REPLACE_ME

# Authentication — Shared JWT secret with ROC Academy (min 32 chars)
JWT_SECRET=REPLACE_ME

# Tavus CVI — API key from tavus.io dashboard
TAVUS_API_KEY=REPLACE_ME

# OpenAI — API key for GPT-4o scoring and coaching
OPENAI_API_KEY=REPLACE_ME

# ROC Academy — Base URL for completion callbacks
ROC_ACADEMY_URL=http://localhost:3000

# Simulator Sync — Dedicated secret for authenticating callbacks to ROC Academy
# Must NOT be the same as JWT_SECRET. Create a separate value.
SIMULATOR_SYNC_SECRET=REPLACE_ME

# Training access code — shared with reps to gate login (required)
TRAINING_ACCESS_CODE=REPLACE_ME

# Facilitator user IDs — comma-separated, get admin role on login
FACILITATOR_IDS=john_hamilton,kevin_reed,mike_mccaffrey,zack_zivkovich
