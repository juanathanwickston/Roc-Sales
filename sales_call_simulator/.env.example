# Tavus CVI
TAVUS_API_KEY=your-tavus-api-key-here

# OpenAI (for post-call scoring only)
OPENAI_API_KEY=sk-...

# Database (Postgres connection string from Railway)
DATABASE_URL=postgresql://user:password@host:port/database

# Server
PORT=3001
NODE_ENV=development

# Auth (must match ROC Academy's JWT_SECRET)
JWT_SECRET=same-secret-as-roc-academy

# ROC Academy Integration
ROC_ACADEMY_URL=http://localhost:3000
